# Las escribe `neon env pull` (conexion pooled para la app, unpooled para migraciones)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# Neon Object Storage (S3). Las AWS_* tambien las escribe `neon env pull`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
S3_BUCKET=receipts

# Header X-Proxy-Secret que envia el proxy de SvelteKit (openssl rand -hex 32)
PROXY_SECRET=

# Recuperacion de contraseña (Resend). Vacio = el correo sale en los logs (desarrollo)
RESEND_API_KEY=
# Remitente verificado en Resend
EMAIL_FROM=InflatCO <onboarding@resend.dev>
# URL del frontend, base del link de recuperacion
FRONTEND_URL=http://localhost:5173

# Gemini (Fase 2)
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
